# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (Docker Compose defaults). Staging and production URLs are injected by
# CI/CD, never kept here.
DATABASE_URL=postgres://barber:barber@localhost:5432/barber

# Integration tests always use this database, never DATABASE_URL (see
# tests/support/setup-env.ts) — they truncate every table, so they get their own.
# Same Postgres container as the dev database, separate database inside it.
TEST_DATABASE_URL=postgres://barber:barber@localhost:5432/barber_test

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# The zone the shop's opening hours are written in. Must be a real IANA zone —
# startup fails otherwise, because a silent fallback to UTC would shift every day.
SHOP_TIMEZONE=America/Sao_Paulo

# How many hours before the start a client may still cancel or reschedule on their
# own. Inside the window they have to call the shop; staff are never restricted.
CANCELLATION_WINDOW_HOURS=24

# Card fees as fractions of the amount (0.035 = 3.5%). The absolute fee is stored
# on each payment when it is recorded, so changing these never rewrites history.
CARD_FEE_RATE_DEBIT=0.015
CARD_FEE_RATE_CREDIT=0.035
