BARBER_ENV=prod
CADDY_EMAIL=you@barbearia360.app

# Interpolated into DATABASE_URL, so it must be URL-safe: `openssl rand -hex 32`.
# Base64 output can contain + / = and produces an invalid URL.
POSTGRES_PASSWORD=change-me-prod-db-password
JWT_SECRET=change-me-to-a-different-long-random-string-at-least-32-chars
LOG_LEVEL=info
SHOP_TIMEZONE=America/Sao_Paulo
CANCELLATION_WINDOW_HOURS=24
CARD_FEE_RATE_DEBIT=0.015
CARD_FEE_RATE_CREDIT=0.035

# Multi-tenancy: shops answer at <slug>.SHOPS_BASE_DOMAIN or their custom domain.
SHOPS_BASE_DOMAIN=barbearia360.app
PLATFORM_HOSTS=crm.barbearia360.app
# Only used when migrating a database that already has data: domain assigned
# to the "default" shop that adopts the existing rows. Leave empty for fresh DBs.
DEFAULT_SHOP_DOMAIN=

API_IMAGE=ghcr.io/helmutiarley/barber-api:prod
WEB_IMAGE=ghcr.io/helmutiarley/barber-web:prod
CRM_IMAGE=ghcr.io/helmutiarley/barber-crm:prod
