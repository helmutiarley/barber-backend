{
  "name": "barber-backend",
  "version": "1.0.0",
  "description": "Barbershop management API",
  "type": "commonjs",
  "scripts": {
    "start:db": "docker compose up -d --wait --remove-orphans",
    "stop:db": "docker compose stop",
    "logs:db": "docker compose logs -f",
    "reset:db": "docker compose down -v --remove-orphans && npm run start:db && npm run migration:run && npm run seed",
    "start:backend": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node build/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/lib/typeorm-cli.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d ./build/lib/typeorm-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helmutiarley/barber-backend.git"
  },
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "awilix": "^13.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
